# Copy to backend/.env and fill in. Never commit .env.

# --- Required ---
GEMINI_API_KEY=your_gemini_api_key_here

# Bootstrap admin account (created/updated in the SQLite DB at startup).
# ADMIN_USERNAME/ADMIN_PASSWORD and LOGIN_USERNAME/LOGIN_PASSWORD are accepted as aliases.
APP_USERNAME=admin@example.com
APP_PASSWORD=change_me

# --- Deployment ---
# Subpath the API is served under (must match the reverse proxy / frontend NEXT_PUBLIC_BASE_PATH)
ROOT_PATH=/HdMImageVideo

# Comma-separated list of allowed browser origins for CORS
CORS_ORIGINS=http://localhost:3000

# --- Optional: model availability (comma-separated model ids) ---
# ENABLED_IMAGE_MODELS=
# DISABLED_IMAGE_MODELS=
# DEFAULT_IMAGE_MODEL=
# ENABLED_VIDEO_MODELS=
# DISABLED_VIDEO_MODELS=
# DEFAULT_VIDEO_MODEL=
# ENABLED_SPEECH_MODELS=
# DISABLED_SPEECH_MODELS=
# DEFAULT_SPEECH_MODEL=

# --- Optional: feature flags (true/false, default true) ---
# ENABLE_IMAGE_GENERATION=true
# ENABLE_VIDEO_GENERATION=true
# ENABLE_MUSIC_GENERATION=true
# ENABLE_SPEECH_GENERATION=true

# --- Optional: admin model config file (default: backend/data/admin-config.json) ---
# ADMIN_CONFIG_PATH=/app/data/admin-config.json
